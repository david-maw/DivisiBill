<Project>
  <PropertyGroup>
    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
    <PackageVersion Include="CommunityToolkit.Maui.Maps" Version="4.0.0" />
    <PackageVersion Include="epj.RouteGenerator" Version="1.0.5" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="CommunityToolkit.Common" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Maui.Controls.Maps" Version="10.0.110" />
    <PackageVersion Include="Sentry.Maui" Version="6.11.1" />
    <PackageVersion Include="Sentry.Profiling" Version="6.11.1" />
    <PackageVersion Include="SkiaSharp" Version="4.152.1" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <!-- Beware, version 9.1.102 of BillingClient is not compatible with .NET 10.0 -->
    <PackageVersion Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>