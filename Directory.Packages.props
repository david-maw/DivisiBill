<Project>
  <PropertyGroup>
    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui.Camera" Version="8.0.0" />
    <PackageVersion Include="epj.RouteGenerator" Version="1.0.5" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="11.0.0-preview.5.26304.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageVersion Include="CommunityToolkit.Common" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Maui.Controls.Maps" Version="11.0.10" />
    <PackageVersion Include="Sentry.Maui" Version="7.0.0-rc.2" />
    <PackageVersion Include="Sentry.Profiling" Version="7.0.0-rc.2" />
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- Beware, version 9.1.102 of BillingClient requires these pinned versions of Xamarin.AndroidX.Fragment...  -->
    <PackageVersion Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.2" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
  </ItemGroup>
</Project>