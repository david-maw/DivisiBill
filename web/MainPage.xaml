<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Divisibill Help Simulator"
             x:Class="web.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Welcome to &#10;DivisiBill Help"
                Style="{StaticResource SubHeadline}" />

            <Button Text="Help Index" Clicked="OnHelpIndexClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
