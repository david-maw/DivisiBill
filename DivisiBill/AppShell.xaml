<Shell
    Title="DivisiBill"
    x:Class="DivisiBill.AppShell">

    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <ContentView BackgroundColor="Red" HeightRequest="100">
                <Image Aspect="AspectFit" Margin="10" Source="divisibillfg.png"/>
            </ContentView>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>
    <Shell.ItemTemplate>
        <DataTemplate>
            <ContentView>
                <!--x:DataType="BaseShellItem" Handles FlyoutItem too-->
                <Label Text="{Binding Title}" FontSize="{OnIdiom Phone={StaticResource FontSizeMedium}}"
                       x:DataType="BaseShellItem"
                       Margin="20, 8"
                       VerticalTextAlignment="Center" />
            </ContentView>
        </DataTemplate>
    </Shell.ItemTemplate>
    <Shell.MenuItemTemplate>
        <DataTemplate>
            <ContentView>
                <!--x:DataType="BaseShellItem" Handles MenuItem too, why it is not BaseMenuItem or MenuItem though is a mystery-->
                <!--The Text property is mapped to Title by MenuShellItem, see https://github.com/dotnet/maui/issues/25190-->
                <Label Text="{Binding Title}" FontSize="{OnIdiom Phone={StaticResource FontSizeMedium}}"
                       x:DataType="BaseShellItem"
                       Margin="20, 8"
                       VerticalTextAlignment="Center" />
            </ContentView>
        </DataTemplate>
    </Shell.MenuItemTemplate>
    <TabBar>
        <!--This is the initial page, used to decide what to show the user first, it is normally never visible -->
        <ShellContent ContentTemplate="{DataTemplate GettingStartedPage}" Route="{x:Static Routes.GettingStartedPage}"/>
        <!--This is the initialization page the user normally sees, ShellContent items with routes are navigated to in code-->
        <ShellContent ContentTemplate="{DataTemplate SplashPage}" Route="{x:Static Routes.SplashPage}"/>
    </TabBar>
    <ShellContent Title="Items" ContentTemplate="{DataTemplate LineItemsPage}" Route="{x:Static Routes.LineItemsPage}"/>
    <ShellContent Title="Totals" ContentTemplate="{DataTemplate TotalsPage}" Route="{x:Static Routes.TotalsPage}"/>
    <MenuItem      Text="Camera" Clicked="GoToImagePageWithCamera"/>
    <ShellContent Title="Image" ContentTemplate="{DataTemplate ImagePage}" Route="{x:Static Routes.ImagePage}"/>
    <ShellContent Title="Properties" ContentTemplate="{DataTemplate PropertiesPage}" Route="{x:Static Routes.PropertiesPage}"/>
    <ShellContent Title="List Saved Bills by Age" ContentTemplate="{DataTemplate MealListByAgePage}" Route="{x:Static Routes.MealListByAgePage}"/>
    <ShellContent Title="List Saved Bills by Name" ContentTemplate="{DataTemplate MealListByNamePage}"/>
    <ShellContent Title="List Saved Bills by Distance" ContentTemplate="{DataTemplate MealListByDistancePage}"/>
    <ShellContent Title="Manage Data" ContentTemplate="{DataTemplate DataManagementPage}"/>
    <ShellContent Title="List Venues by Name" ContentTemplate="{DataTemplate VenueListByNamePage}"/>
    <ShellContent Title="List Venues by Distance" ContentTemplate="{DataTemplate VenueListByDistancePage}"/>
    <ShellContent Title="List People" ContentTemplate="{DataTemplate PeopleListPage}"/>
    <ShellContent Title="Program Settings" ContentTemplate="{DataTemplate SettingsPage}"/>
    <FlyoutItem Title="Information and Problems" Route="Information" FlyoutDisplayOptions="AsSingleItem">
        <ShellContent Title="About" ContentTemplate="{DataTemplate AboutPage}" Shell.TabBarIsVisible="True"/>
        <ShellContent Title="Release Notes" ContentTemplate="{DataTemplate ReleaseNotesPage}" Shell.TabBarIsVisible="True" Route="{x:Static Routes.ReleaseNotesPage}"/>
        <ShellContent Title="Report a problem" ContentTemplate="{DataTemplate ProblemReportPage}" Shell.TabBarIsVisible="True"/>
    </FlyoutItem>
    <MenuItem     Text="Help Index" Clicked="OnHelpIndexClicked"/>
    <MenuItem     Text="Help" Clicked="OnHelpClicked"/>
    <ShellContent Title="Tutorial" ContentTemplate="{DataTemplate TutorialPage}" Route="{x:Static Routes.TutorialPage}"/>
    <MenuItem     Text ="Exit" Clicked="OnExitClicked"/>
</Shell>
