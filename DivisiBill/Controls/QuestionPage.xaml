<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="DivisiBill.Controls.QuestionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DivisiBill"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:DivisiBill.Controls"
    x:DataType="views:QuestionPage"
    x:TypeArguments="views:QuestionResponse"
    BindingContext="{Binding Source={RelativeSource Self}, x:DataType=views:QuestionPage}"
    BackgroundColor="Transparent"
    Padding="0"
    Margin="0">
    <Border
        Padding="10"
        BackgroundColor="{AppThemeBinding Light={StaticResource White},
        Dark={StaticResource Gray900}}"
        HorizontalOptions="Center"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="2">
        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
            <Label
                FontSize="{StaticResource FontSizeLarge}"
                HorizontalOptions="Center"
                Text="{Binding Title}" />
            <Label Text="{Binding Text}" />
            <RadioButton
                Margin="7,10,0,0"
                Content="Yes"
                IsChecked="{Binding Yes}" />
            <RadioButton
                Margin="7,-10,0,0"
                Content="No"
                IsChecked="{Binding Yes, Converter={StaticResource Not}}" />
            <HorizontalStackLayout>
                <CheckBox IsChecked="{Binding AskAgain, Converter={StaticResource Not}}" />
                <Label Text="Do not ask again" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button
                Clicked="Button_Clicked"
                HorizontalOptions="Center"
                Text="Done" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>