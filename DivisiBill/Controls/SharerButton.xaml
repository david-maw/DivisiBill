<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DivisiBill.Controls"
             x:Class="DivisiBill.Controls.SharerButton"
             x:Name="This">
    <Border x:Name="ButtonBorder"
            Padding="1"
            BackgroundColor="{Binding BackgroundColor, Source={x:Reference This}}"
            Stroke="{Binding BorderColor, Source={x:Reference This}}"
            StrokeThickness="{Binding BorderWidth, Source={x:Reference This}}"
            StrokeShape="RoundRectangle 10"
            HorizontalOptions="Fill">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference This}}"
                                  CommandParameter="{Binding CommandParameter, Source={x:Reference This}}" />
            <LongPressGestureRecognizer Command="{Binding LongPressCommand, Source={x:Reference This}}"
                                        CommandParameter="{Binding LongPressCommandParameter, Source={x:Reference This}}" />
        </Border.GestureRecognizers>

        <Label Text="{Binding Text, Source={x:Reference This}}"
               TextColor="{Binding TextColor, Source={x:Reference This}}"
               LineBreakMode="NoWrap"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </Border>
</ContentView>
