<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns:views="clr-namespace:DivisiBill.Controls"
    x:DataType="views:AppSnackBarPage"
    BindingContext="{Binding Source={RelativeSource Self}, x:DataType=views:AppSnackBarPage}"
    BackgroundColor="Transparent"
    Margin="0,0,0,5"
    Padding="0"
    VerticalOptions="End"
    x:Class="DivisiBill.Controls.AppSnackBarPage">
    <Border Padding="5" StrokeShape="RoundRectangle 10"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightRed}, Dark={StaticResource DarkRed}}" VerticalOptions="End">
        <Label Text="{Binding Text}" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" HorizontalOptions="Center"/>
    </Border>
</toolkit:Popup>