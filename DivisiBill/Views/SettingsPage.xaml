<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:services="clr-namespace:DivisiBill.Services"
             xmlns:controls="clr-namespace:DivisiBill.Controls"
             xmlns:DivisiBill="clr-namespace:DivisiBill"
             xmlns:vm="clr-namespace:DivisiBill.ViewModels"
             BindingContext="{vm:SettingsViewModel}"
             x:DataType="vm:SettingsViewModel"
             Title="Program Settings"
             x:Class="DivisiBill.Views.SettingsPage">

    <ContentPage.Resources>
        <Style TargetType="controls:AmountEntry">
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="ValidStyle" Value="{StaticResource ValidEntryStyle}" />
            <Setter Property="InvalidStyle" Value="{StaticResource InvalidEntryStyle}" />
            <Setter Property="UnequalStyle" Value="{StaticResource UnequalEntryStyle}" />
            <Style.Triggers>
                <Trigger TargetType="controls:AmountEntry" Property="IsFocused" Value="True">
                    <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
                    <Setter Property="FontAttributes" Value="Bold" />
                </Trigger>
                <Trigger TargetType="controls:AmountEntry" Property="IsFocused" Value="False">
                    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                    <Setter Property="FontAttributes" Value="None" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <ScrollView Margin="20,0,10,0">
        <VerticalStackLayout>
            <!--#region Heading -->
            <!--Note that only one of the next two lines is visible-->
            <Label FontSize="{StaticResource FontSizeLarge}" HorizontalOptions="Center" Text="DivisiBill Basic Edition" IsVisible="{Binding Path=IsLimited}"/>
            <Label FontSize="{StaticResource FontSizeLarge}" HorizontalOptions="Center" Text="DivisiBill Pro Edition" IsVisible="{Binding Path=IsLimited, Converter={StaticResource Not}}"/>
            <!--Show the current location of the device the app is running on -->
            <Label Text="{Binding Path=AppLocation, StringFormat='Current Location={0}', Converter={StaticResource Location}, TargetNullValue='Location Unknown'}" HorizontalOptions="Center" IsVisible="{Binding UseLocation}"/>
            <!--#endregion-->
            <!--#region License Error Reporting -->
            <VerticalStackLayout IsVisible="{Binding Path=LicenseChecked, Converter={StaticResource Not}}">
                <Label Text="Pro Edition Verification Incomplete" FontSize="{StaticResource FontSizeMedium}" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="{Binding ProSubscriptionId, StringFormat='Pro Subscription: {0}'}" IsVisible="{Binding HasProSubscription}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <!--#endregion-->
            <!--#region Regular Application Settings -->
            <BoxView HeightRequest="2" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <!--Everything in this Grid is in the current meal data context although they are defaults that apply to all new meals-->
            <Grid ColumnDefinitions ="*, auto, *, auto, auto" RowDefinitions="auto, auto, auto, auto, auto, auto, auto" ColumnSpacing="{OnPlatform 10, Android=0}" x:Name="MealSection"
                    x:DataType="vm:MealViewModel" BindingContext="{StaticResource MealViewModel}">
                <Label Grid.Row="1" Grid.Column="0" Text="Tip on Tax" VerticalOptions="Center" HorizontalOptions="End"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DefaultTipOnTax}" HorizontalOptions="End"/>
                <Label Grid.Row="1" Grid.Column="2" Text="Tip Percentage" VerticalOptions="Center" HorizontalOptions="End" Margin="10,0,0,0"/>
                <controls:AmountEntry Grid.Row="1" Grid.Column="3" Text="{Binding DefaultTipRatePercentage}" MaxLength="2" MinimumValue="0" MaximumValue="99" />
                <Label Grid.Row="1" Grid.Column="4" Text="%" VerticalOptions="Center"/>
                <Label Grid.Row="2" Text="Coupon After Tax" VerticalOptions="Center" HorizontalOptions="End"/>
                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding DefaultTaxOnCoupon}"/>
                <Label Grid.Row="2" Grid.Column="2" Text="Tax Percentage" VerticalOptions="Center" HorizontalOptions="End" Margin="10,0,0,0"/>
                <controls:AmountEntry Grid.Row="2" Grid.Column="3" Amount="{Binding DefaultTaxRatePercentage}" WidthRequest="80" MinimumValue="0" MaximumValue="99.99"/>
                <Label Grid.Row="2" Grid.Column="4" Text="%" VerticalOptions="Center"/>
            </Grid>
            <!--#endregion-->
            <!--#region Hint, CheckBoxes and Dark Mode-->
            <Grid ColumnDefinitions="*,*" RowDefinitions="auto, auto" ColumnSpacing="10" RowSpacing="10" Margin="30,10,30,10">
                <Button Text="Restore Hints" LineBreakMode="WordWrap" Command="{Binding EnableHintsCommand}"/>
                <Button Grid.Column="1" Text="Clear CheckBoxes" LineBreakMode="WordWrap" Command="{Binding ResetCheckBoxesCommand}"/>
                <Button Grid.Row="1" Text="System Settings" LineBreakMode="WordWrap" Command="{Binding SystemSettingsCommand}"/>
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, auto" ColumnSpacing="{OnPlatform 10, Android=0}">
                    <Label Text="Dark UI" VerticalOptions="Center" HorizontalOptions="End"/>
                    <Switch Grid.Column="1" IsToggled="{Binding Dark}" HorizontalOptions="End" Margin="20,0,0,0"/>
                </Grid>
            </Grid>
            <!--#endregion-->
            <!--#region Cloud UI -->
            <BoxView HeightRequest="2" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <!--#region Basic Edition or Internet Inaccessible -->
            <Label Text="Pro subscription backup is unavailable" HorizontalOptions="Center"
                   IsVisible="{Binding InternetEnabledAndLicensed, Converter={StaticResource Not}}"/>
            <!--#endregion-->
            <!--#region Pro Subscription and Internet Accessible (Cloud Access and Use) -->
            <VerticalStackLayout IsVisible="{Binding InternetEnabledAndLicensed}">
                <Label Text="{Binding Path=WiFiStatus,StringFormat='Internet Enabled ({0})'}" HorizontalOptions="Center" Margin="0,10,0,0"/>
                <Grid ColumnDefinitions ="*, auto, *, auto" RowDefinitions="auto, auto" HorizontalOptions="Center" ColumnSpacing="{OnPlatform 10, Android=0}">
                    <Label Grid.Row="0" Text="Allow Cloud Backup" VerticalOptions="Center" HorizontalOptions="End"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsCloudAccessAllowed}" />
                    <Label Grid.Row="0" Grid.Column="2" Text="Only with WiFi" VerticalOptions="Center" HorizontalOptions="End" Margin="20,0,0,0"/>
                    <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding WiFiOnly}" IsEnabled="{Binding IsCloudAccessAllowed}" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Cloud Backup Images" VerticalOptions="Center" HorizontalOptions="End"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding BackupImages}" IsEnabled="{Binding IsCloudAccessAllowed}" />
                    <Label Grid.Row="1" Grid.Column="2" Text="Images Only with WiFi" VerticalOptions="Center" HorizontalOptions="End" Margin="20,0,0,0"/>
                    <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding BackupImagesOnlyWiFi}" IsEnabled="{Binding WiFiOnly,Converter={StaticResource Not}}" />
                </Grid>
            </VerticalStackLayout>
            <!--#region Password Control -->
            <HorizontalStackLayout HorizontalOptions="Center">
                <!--Only show one of the two following buttons-->
                <Button Text="Set Password" Command="{Binding ChangePasswordCommand}" Margin="5" IsVisible="{Binding HasPassword,Converter={StaticResource Not}}"/>
                <Button Text="Change Password" Command="{Binding ChangePasswordCommand}" Margin="5" IsVisible="{Binding HasPassword}"/>
                <Button Text="Clear Password" Command="{Binding ClearPasswordCommand}" Margin="5" IsVisible="{Binding HasPassword}"/>
                <!--#endregion-->
            </HorizontalStackLayout>
            <!--#endregion-->
            <!--#endregion-->
            <!--#region In App Purchases -->
            <BoxView HeightRequest="2" HorizontalOptions="Fill" Margin="0, 5, 0, 0" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <Label Text="Pro subscription and OCR feature not available" IsVisible="{Binding WsUriDefined, Converter={StaticResource Not}}" HorizontalOptions="Center"/>
            <Label Text="Program built without web services" IsVisible="{Binding WsUriDefined, Converter={StaticResource Not}}" HorizontalOptions="Center"/>
            <Grid IsVisible="{Binding WsUriDefined}">
                <VerticalStackLayout IsVisible="{Binding LicenseChecked}">
                    <Label HorizontalOptions="Center" Margin="0,5" >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LicensingHelpCommand}"/>
                        </Label.GestureRecognizers>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Tap " FontSize="{StaticResource FontSizeLarge}"/>
                                <Span Text="here" TextDecorations="Underline" FontAttributes="Bold" FontSize="{StaticResource FontSizeLarge}" TextColor="{StaticResource MediumSpringGreen}"/>
                                <Span Text=" for licensing help" FontSize="{StaticResource FontSizeLarge}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <!--#region Pro Subscription -->
                    <Button Text="Purchase Pro Subscription" Command="{Binding PurchaseUpgradeCommand}" HorizontalOptions="Center" IsVisible="{Binding HasProSubscription, Converter={StaticResource Not}}"/>
                    <Button Text="Modify Pro Subscription" Command="{Binding RemoveUpgradeCommand}" HorizontalOptions="Center" Margin="5" IsVisible="{Binding Path=HasProSubscription}"/>
                    <!--The following button is used for testing pro licenses only and is not normally shown-->
                    <Button Text="*Purchase Pro License*" Command="{Binding PurchaseProLicenseCommand}" HorizontalOptions="Center" IsVisible="False"/>
                    <Label Text="Unverified Pro Subscription Found" FontAttributes="Bold" IsVisible="{Binding InvalidProSubscription}" HorizontalOptions="Center"/>
                    <Label Text="{Binding ProSubscriptionId, StringFormat='Order# {0}'}" IsVisible="{Binding HasProSubscription}" HorizontalOptions="Center"/>
                    <!--#endregion-->
                    <!--#region OCR Scan License -->
                    <BoxView HeightRequest="2" HorizontalOptions="Fill" Margin="0, 5, 0, 0" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                    <Label Text="{Binding ScansLeft, StringFormat='You have {0} OCR Scans Left'}" Margin="0, 5, 0, 5" HorizontalOptions="Center"/>
                    <Button Text="Purchase additional OCR Scans" Command="{Binding PurchaseOcrScansCommand}"
                            HorizontalOptions="Center" IsVisible="{Binding Path=IsOcrPurchaseAllowed}"/>
                    <Label Text="Unverified OCR Order Detected" FontAttributes="Bold" IsVisible="{Binding InvalidOcrLicense}" HorizontalOptions="Center"/>
                    <Label Text="{Binding OcrLicenseId, StringFormat='Latest Order# {0}'}" IsVisible="{Binding HasOcrLicense}" HorizontalOptions="Center"/>
                    <!--#endregion-->
                </VerticalStackLayout>
                <Label Text="No license information is available" IsVisible="{Binding LicenseChecked, Converter={StaticResource Not}}" HorizontalOptions="Center"/>
                <ActivityIndicator HorizontalOptions="Center" VerticalOptions="Fill" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
            </Grid>
            <!--#endregion-->
            <!--#region Telemetry -->
            <BoxView HeightRequest="2" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <Grid ColumnDefinitions="*, auto, *, auto" HorizontalOptions="Center">
                <Label Grid.Column="0" Text="Send Data on Crash" VerticalOptions="Center" HorizontalOptions="End"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding SendCrashYes}"/>
                <Label Grid.Column="2" Text="Ask After Restart" VerticalOptions="Center" HorizontalOptions="End"/>
                <CheckBox Grid.Column="3" IsChecked="{Binding SendCrashAsk}"/>
            </Grid>
            <BoxView HeightRequest="2" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <!--#endregion-->
            <!--#region Diagnostic and Developer stuff (Debug Builds Only)-->
            <VerticalStackLayout IsVisible="{x:Static services:Utilities.IsDebug}">
                <!--Large blank space before-->
                <BoxView HeightRequest="2" HorizontalOptions="Fill" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" Margin="0, 350, 0, 0" />
                <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeLarge}" Text="Debug"/>
                <!--#region Show Base Folder Path -->
                <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeSmall}" Text="{x:Static DivisiBill:App.BaseFolderPath}"/>
                <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeSmall}" Text="{Binding BaseAddress}"/>
                <!--#endregion-->
                <!--#region Show Last Use -->
                <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeSmall}" Text="{Binding LastUse,StringFormat='Prior Use: {0}'}"/>
                <!--#endregion-->
                <!--#region Start Fresh Next Time (handy for testing) -->
                <Grid ColumnDefinitions ="*, auto" HorizontalOptions="Center" ColumnSpacing="{OnPlatform 10, Android=0}">
                    <Label Grid.Row="0" Text="Start Fresh Next Time" VerticalOptions="Center" HorizontalOptions="End"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding StartFresh}"/>
                </Grid>
                <!--#endregion-->
                <!--#region Scan Options -->
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Label Text="Scan Option:" VerticalOptions="Center"/>
                    <Picker Title="Select a scan option" SelectedIndex="{Binding ScanOption}" FontSize="{StaticResource FontSizeSmall}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Actual Scan</x:String>
                                <x:String>Return Fault</x:String>
                                <x:String>Return Fake Result</x:String>
                                <x:String>Throw Exception</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </HorizontalStackLayout>
                <!--#endregion-->
                <!--#region Fake Location -->
                <ActivityIndicator IsRunning="{Binding IsSwitchingToFakeLocation}" Margin="10"/>
                <Label Text="{Binding Path=FakeLocation, StringFormat='Fake Location={0}', Converter={StaticResource Location}, TargetNullValue='No Fake Location'}" HorizontalOptions="Center"/>
                <HorizontalStackLayout HorizontalOptions="Center" Margin="0,10,0,0" Spacing="10">
                    <Button Text="Set Fake Location" Command="{Binding SetFakeLocationCommand}"/>
                    <Button Text="Clear Fake Location" Command="{Binding ClearFakeLocationCommand}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="{OnPlatform 10, Android=0}">
                    <Label Text="Use Fake Location" VerticalOptions="Center"/>
                    <Switch IsToggled="{Binding UseFakeLocation}" VerticalOptions="Center" IsEnabled="{Binding IsFakeLocationChangeable}" />
                </HorizontalStackLayout>
                <!--#endregion-->
            </VerticalStackLayout>
            <!--#endregion-->
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>