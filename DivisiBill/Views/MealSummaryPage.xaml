<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DivisiBill.Models"
             xmlns:services="clr-namespace:DivisiBill.Services"
             xmlns:vm="clr-namespace:DivisiBill.ViewModels"
             xmlns:DivisiBill="clr-namespace:DivisiBill"
             BindingContext="{vm:MealSummaryViewModel}"
             x:DataType="vm:MealSummaryViewModel"
             x:Class="DivisiBill.Views.MealSummaryPage"
             Shell.FlyoutBehavior="Disabled"
             Title="Bill Summary">
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{StaticResource GlyphImport}" Command="{Binding LoadMealCommand}"/>
        <ToolbarItem IconImageSource="{StaticResource GlyphDel}" Command="{Binding DeleteMealCommand}"/>
    </ContentPage.ToolbarItems>

    <services:ColumnLayout Spacing="2" Padding="5">
        <!--#region Venue -->
        <Label Text="{Binding VenueName}" FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold" HorizontalTextAlignment="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenVenueCommand}"/>
            </Label.GestureRecognizers>
        </Label>
        <!--#endregion-->
        <!--#region Creation and Update Times -->
        <Label HorizontalTextAlignment="Center" FontSize="{StaticResource FontSizeSmall}"
               Text="{Binding CreationTime, StringFormat='Created {}',  Converter={StaticResource ApproximateDateTime}}"/>

        <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeSmall}" IsVisible="{Binding IsLastChangeTimeDifferent}"
               Text="{Binding LastChangeTimeText, StringFormat='Last Updated {0}'}"/>
        <!--#endregion-->
        <!--#region Encrypted -->
        <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeSmall}" IsVisible="{Binding IsEncrypted}" Text="Remote Data is Encrypted"/>
        <!--#endregion-->
        <!--#region Current Bill Status -->
        <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeSmall}" IsVisible="{Binding IsForCurrentMeal}"
               Text="This is the current bill"/>
        <!--#endregion-->
        <!--#region Meal ID (debug only) -->
        <Label HorizontalOptions="Center" FontSize="{StaticResource FontSizeSmall}" IsVisible="{x:Static services:Utilities.IsDebug}"
               Text="{Binding Id, StringFormat='Id: {0}'}"/>
        <!--#endregion-->
        <!--#region Amounts -->
        <Label FontSize="{StaticResource FontSizeLarge}" Text="{Binding RoundedAmount, StringFormat='Rounded total {0:C0}'}" IsVisible="{Binding HasMealInfo}"
               HorizontalTextAlignment="Center"/>
        <Label FontSize="{StaticResource FontSizeLarge}" Text="{Binding UnallocatedAmount, StringFormat='Unallocated {0:C0}'}"
               HorizontalTextAlignment="Center" IsVisible="{Binding Path=IsAnyUnallocated}"/>
        <!--#endregion-->
        <!--#region Stored Image Status -->
        <Label Text="This bill has a corresponding stored image" IsVisible="{Binding Path=HasImage}" HorizontalTextAlignment="Center"/>
        <Label Text="This bill has a deleted image" IsVisible="{Binding Path=HasDeletedImage}" HorizontalTextAlignment="Center"/>
        <Label Text="This bill has a remote image" IsVisible="{Binding Path=HasRemoteImage}" HorizontalTextAlignment="Center"/>
        <!--#endregion-->
        <!--#region Storage Location -->
        <VerticalStackLayout IsVisible="{Binding ShowStorage}">
            <Label Text="This bill is stored locally" IsVisible="{Binding Path=IsLocal}" HorizontalTextAlignment="Center"/>
            <Label Text="This bill is stored remotely" IsVisible="{Binding Path=IsRemote}" HorizontalTextAlignment="Center"/>
            <Label Text="This bill is not stored anywhere" IsVisible="{Binding Path=IsFake}" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
        <!--#endregion-->
        <!--#region Error Reporting -->
        <Label TextColor="{AppThemeBinding Light={StaticResource DarkRed}, Dark={StaticResource LightRed}}" IsVisible="{Binding Path=IsBad}">
            <Label.FormattedText>
                <FormattedString >
                    <Span Text="This bill has an error: " FontSize="{StaticResource FontSizeMedium}"/>
                    <Span Text="{Binding ErrorMessage}" FontSize="{StaticResource FontSizeMedium}"/>
                    <Span Text="&#10;"/>
                    <!--Newline-->
                    <Span Text="Probably in file: " FontSize="{StaticResource FontSizeMedium}"/>
                    <Span Text="{Binding FileName}" FontSize="{StaticResource FontSizeMedium}"/>
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <!--#endregion-->
        <!--#region Item Count -->
        <Label Text="{Binding LineItemCount,StringFormat='Items = {0}'}" IsVisible="{Binding HasMealInfo}" FontSize="{StaticResource FontSizeLarge}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
        <!--#endregion-->
        <!--#region Costs (Participant List) -->
        <Label Text="Participants" FontSize="{StaticResource FontSizeLarge}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
        <CollectionView
            ItemsSource="{Binding Costs}"
            VerticalOptions="Start">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PersonCost">
                    <Grid Margin="20,0,20,0" RowDefinitions="Auto" ColumnDefinitions="*,Auto">
                        <Label x:Name="NicknameLabel" Text="{Binding Nickname} " Grid.Column="0"
                               LineBreakMode="NoWrap"
                               FontSize="{StaticResource FontSizeLarge}" />

                        <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{0:C}'}" Margin="0,0,10,0"
                               LineBreakMode="NoWrap"
                               FontSize="{StaticResource FontSizeLarge}" IsEnabled="True" HorizontalTextAlignment="End" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--#endregion-->
    </services:ColumnLayout>
</ContentPage>