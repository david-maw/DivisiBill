<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DivisiBill.Views.CameraPage"
             x:DataType="CameraViewModel"
             BindingContext="{CameraViewModel}"
             Shell.FlyoutBehavior="Disabled"
             Title="Camera">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:BoolToObjectConverter
                x:Key="FlashIconConverter"
                FalseObject="{StaticResource GlyphFlashOff}"
                TrueObject="{StaticResource GlyphFlashOn}" />
            <toolkit:BoolToObjectConverter
                x:Key="LightIconConverter"
                FalseObject="{StaticResource GlyphFlashlightOff}"
                TrueObject="{StaticResource GlyphFlashlightOn}" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{Binding IsTorchOn, Converter={StaticResource LightIconConverter}}" Command="{Binding ChangeTorchModeCommand}"/>
        <ToolbarItem IconImageSource="{StaticResource GlyphImages}" Command="{Binding BrowseCommand}"/>
        <ToolbarItem IconImageSource="{Binding IsFlashOn, Converter={StaticResource FlashIconConverter}}" Command="{Binding ChangeFlashModeCommand}"/>
        <ToolbarItem IconImageSource="{StaticResource GlyphCameraFlip}" Command="{Binding SwitchCameraCommand}"/>
    </ContentPage.ToolbarItems>
    <!--It's a grid but everything is in the same row and column-->
    <Grid>
        <!--#region Camera View -->
        <toolkit:CameraView x:Name="MyCamera"
                            IsVisible="{Binding IsCameraAvailable}"
                            CameraFlashMode="{Binding FlashMode}"
                            IsTorchOn="{Binding IsTorchOn}"
                            MediaCaptured="OnPictureTaken"
                            SelectedCamera="{Binding SelectedCamera}"
                            ImageCaptureResolution="{Binding ImageCaptureResolution}"/>
        <!--#endregion-->
        <!--#region Camera Name -->
        <Border Stroke="Transparent"
                StrokeShape="RoundRectangle 10,10,10,10"
                BackgroundColor="Black"
                Padding="15"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                IsVisible="{Binding IsMsgVisible, Mode=TwoWay}"> <!--Two way to trigger fadeBehavior-->
            <Border.Behaviors>
                <services:FadeBehavior/>
            </Border.Behaviors>
            <Label Text="{Binding CameraInfo}"
                   FontSize="{StaticResource FontSizeBody}"
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>
        </Border>
        <!--#endregion-->
        <!--#region Shutter Button -->
        <!--Have to specify x:DataType below until issue https://github.com/dotnet/maui/issues/21834 is implemented -->
        <Ellipse Stroke="Red"
                 Fill="White"
                 StrokeThickness="5"
                 WidthRequest="80"
                 IsVisible="{Binding IsCameraAvailable}"
                 HeightRequest="{Binding Source={RelativeSource Self},Path=WidthRequest, x:DataType=Ellipse}"
                 HorizontalOptions="Center"
                 VerticalOptions="End"
                 Margin="20">
            <Ellipse.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CaptureImageCommand, Source={x:Reference MyCamera}, x:DataType=toolkit:CameraView}"
                                      CommandParameter="{Binding Token}"/>
            </Ellipse.GestureRecognizers>
        </Ellipse>
        <!--#endregion-->
        <!--#region "No Camera" Alternative -->
        <Label Text="No camera available"
               FontSize="{StaticResource FontSizeHeader}"
               IsVisible="{Binding IsCameraAvailable, Converter={StaticResource Not}}"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
        <!--#endregion-->
    </Grid>
</ContentPage>