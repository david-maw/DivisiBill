<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
             xmlns:appmodel ="clr-namespace:Microsoft.Maui.ApplicationModel;assembly=Microsoft.Maui.Essentials"
             BindingContext="{Binding Source={RelativeSource Self}, x:DataType=SplashPage}"
             x:DataType="SplashPage"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="Red"
             x:Class="DivisiBill.Views.SplashPage">
    <!--  This layout is intentionally similar to the GettingStartedPage, so that the transition from one to the other is not jarring to the user  -->
    <Grid
        Margin="0,50,0,0"
        RowDefinitions="auto, 0.3*,1.1*,auto,auto,3*"
        SafeAreaEdges="none">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnStatusTapped"/>
        </Grid.GestureRecognizers>
        <!--Headline-->
        <Label Text="Starting DivisiBill, please wait..." FontSize="{StaticResource FontSizeLarge}" HorizontalOptions="Center"/>
        <!--#region Busy/Paused Indicator-->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding PauseAllowed}">
            <ActivityIndicator IsRunning="{Binding IsPaused, Converter={StaticResource Not}}" Color="Black"
                               MaximumHeightRequest="100"  WidthRequest="{Binding HeightRequest, Source={RelativeSource Self}, x:DataType=ActivityIndicator}"/>
            <Label Text="Tap to pause" IsVisible="{Binding IsPaused,Converter={StaticResource Not}}" FontSize="{StaticResource FontSizeLarge}" HorizontalOptions="Center"/>
            <Label Text="Paused - tap to continue" IsVisible="{Binding IsPaused}" FontSize="{StaticResource FontSizeLarge}" HorizontalOptions="Center"/>
        </VerticalStackLayout>
        <!--#endregion-->
        <!--#region DivisiBill Icon -->
        <Image Grid.Row="2" Source="divisibillfg.png" Margin="10"/>
        <!--#endregion-->
        <!--#region App name and version information -->
        <Label Grid.Row="3" FontSize="{StaticResource FontSizeLarge}" HorizontalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <FormattedString.Spans>
                        <Span Text="DivisiBill " FontSize="{StaticResource FontSizeLarge}" />
                        <Span Text="{x:Static Utilities.VersionName}" FontSize="{StaticResource FontSizeLarge}" FontAttributes="Bold" />
                        <Span x:Name="editionSpan" FontSize="{StaticResource FontSizeLarge}" />
                    </FormattedString.Spans>
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <!--#endregion-->
        <!--#region Build Information -->
        <Label Grid.Row="4" HorizontalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <FormattedString.Spans>
                        <Span Text="{x:Static Utilities.DebugString}"/>
                        <Span Text="{Binding Source={x:Static appmodel:AppInfo.BuildString}, x:DataType=x:String, StringFormat=' Build {0}'}"/>
                        <Span Text="{Binding Source={x:Static Utilities.BuildTime}, x:DataType=x:String, StringFormat=' at {0}'}"/>
                    </FormattedString.Spans>
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <!--#endregion-->
        <!--#region Scrolling initialization progress -->
        <CollectionView Grid.Row="5" x:Name="statusCollectionView" ItemsSource="{Binding StatusMsgList}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding .}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--#endregion-->
    </Grid>
</ContentPage>