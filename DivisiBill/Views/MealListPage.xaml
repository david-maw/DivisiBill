<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DivisiBill.Views.MealListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:DivisiBill.Models"
    xmlns:services="clr-namespace:DivisiBill.Services"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:DivisiBill.ViewModels"
    x:Name="BrowseItemsPage"
    Title="Bills"
    x:DataType="vm:MealListViewModel"
    BindingContext="{vm:MealListViewModel}">

    <ContentPage.Resources>
        <toolkit:BoolToObjectConverter
            x:Key="RemoteIconConverter"
            FalseObject="{StaticResource FileGlyphRemoteOutline}"
            TrueObject="{StaticResource FileGlyphRemote}" />
        <toolkit:BoolToObjectConverter
            x:Key="LocalIconConverter"
            FalseObject="{StaticResource FileGlyphLocalOutline}"
            TrueObject="{StaticResource FileGlyphLocal}" />
        <DataTemplate x:Key="WithSwipe" x:DataType="models:MealSummary">
            <!--#region Bill Summary Info Surrounded by SwipeView-->
            <!--#region SwipeView Start -->
            <SwipeView Grid.Column="1" Grid.ColumnSpan="4">
                <SwipeView.LeftItems>
                    <SwipeItems Mode="Execute">
                        <SwipeItem
                            BackgroundColor="PaleGreen"
                            Command="{Binding InvokeUseMealCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                            CommandParameter="{Binding}"
                            IconImageSource="{StaticResource GlyphLoad}" />
                    </SwipeItems>
                </SwipeView.LeftItems>
                <SwipeView.RightItems>
                    <SwipeItems Mode="Execute">
                        <SwipeItem
                            BackgroundColor="Red"
                            Command="{Binding DeleteMealCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                            CommandParameter="{Binding}"
                            IconImageSource="{StaticResource GlyphDel}" />
                    </SwipeItems>
                </SwipeView.RightItems>
                <!--#endregion-->
                <!--#region Bill Summary Info, but SwipeView does not work with a mouse on Windows so two extra overlaid buttons are made visible-->
                <Grid ColumnDefinitions="Auto, 2*, *, 2*, 50" RowDefinitions="auto,auto">
                    <!--#region MealSummary Display-->
                    <!--#region Item Selection Area-->
                    <Grid
                        Grid.RowSpan="2"
                        Margin="0,0,5,0"
                        IsVisible="{Binding IsSelectableList, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}">
                        <Image
                            Grid.Row="0"
                            IsVisible="{Binding FileSelected}"
                            Source="{StaticResource ListGlyphSelected}"
                            VerticalOptions="Center" />
                        <Image
                            Grid.Row="0"
                            IsVisible="{Binding FileSelected, Converter={StaticResource Not}}"
                            Source="{StaticResource ListGlyphUnselected}"
                            VerticalOptions="Center" />
                    </Grid>
                    <!--#endregion-->
                    <!--#region Bill Summary Info, 2 lines, first one optional-->
                    <!--  First Line, the venue name  -->
                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,-2,0,-5"
                        FontSize="Large"
                        LineBreakMode="TailTruncation"
                        Text="{Binding VenueName}">
                        <Label.IsVisible>
                            <MultiBinding Converter="{StaticResource All}">
                                <Binding
                                    x:DataType="vm:MealListViewModel"
                                    Converter="{StaticResource Not}"
                                    Path="IsGrouped"
                                    Source="{RelativeSource AncestorType={x:Type vm:MealListViewModel}}" />
                                <Binding
                                    x:DataType="vm:MealListViewModel"
                                    Converter="{StaticResource IsStringNullOrWhiteSpace}"
                                    Path="FilteredVenueName"
                                    Source="{RelativeSource AncestorType={x:Type vm:MealListViewModel}}" />
                            </MultiBinding>
                        </Label.IsVisible>
                    </Label>
                    <!--  Second Line - Creation and Location Information  -->
                    <!--  First Item: Creation Time information (date, time, elapsed time)  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        FontSize="Small"
                        Text="{Binding CreationTime, Converter={StaticResource ApproximateDateTime}}"
                        VerticalOptions="Start" />
                    <!--  Second item: Distance Information (May be null)  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,0,10,0"
                        FontSize="Small"
                        HorizontalOptions="End"
                        Text="{Binding Path=Distance, Converter={StaticResource Distance}}"
                        VerticalOptions="Start" />
                    <!--#endregion-->
                    <!--#region activity indicator-->
                    <ActivityIndicator
                        Grid.RowSpan="2"
                        Grid.Column="3"
                        Margin="0,0,20,0"
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsBusy}"
                        VerticalOptions="Fill" />
                    <!--#endregion-->
                    <!--#region Image, Local and Remote Indicators-->
                    <!--  The fixed height row definitions in this grid guarantee the whole grid always occupies a minimum height  -->
                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="4"
                        ColumnDefinitions="25,25"
                        HorizontalOptions="Start"
                        RowDefinitions="25,25"
                        VerticalOptions="Center">
                        <Image
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            IsVisible="{Binding HasImage}"
                            Source="{StaticResource FileGlyphImage}" />
                        <!--  Only show these if cloud access is allowed, otherwise they do not tell the user anything  -->
                        <Image
                            Grid.Row="0"
                            Grid.Column="1"
                            IsVisible="{Binding IsCloudAllowed, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                            Source="{Binding IsRemote, Converter={StaticResource RemoteIconConverter}}" />
                        <Image
                            Grid.Row="1"
                            Grid.Column="1"
                            IsVisible="{Binding IsCloudAllowed, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                            Source="{Binding IsLocal, Converter={StaticResource LocalIconConverter}}" />
                    </Grid>
                    <!--#endregion-->
                    <!--#endregion-->
                    <!--#region Overlaid Buttons-->
                    <!--  This button is used if we're doing multiple selection  -->
                    <ImageButton
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        Command="{Binding SelectMealCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                        CommandParameter="{Binding x:DataType=models:MealSummary}"
                        IsVisible="{Binding IsSelectableList, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}" />
                    <!--  This button simulates swipe right (Use)  -->
                    <ImageButton
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        BackgroundColor="{StaticResource TransparentGreen}"
                        Command="{Binding InvokeUseMealCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                        CommandParameter="{Binding x:DataType=models:MealSummary}"
                        IsVisible="{OnPlatform Default=false,
                                               WinUI=true}" />
                    <!--  This button is in the center to allow simple tap/double tap without unintentional swipe  -->
                    <ImageButton
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        BackgroundColor="Transparent">
                        <ImageButton.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SelectMealCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                                CommandParameter="{Binding}"
                                NumberOfTapsRequired="1" />
                            <TapGestureRecognizer
                                Command="{Binding InvokeShowDetailsCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                                CommandParameter="{Binding}"
                                NumberOfTapsRequired="2" />
                        </ImageButton.GestureRecognizers>
                    </ImageButton>
                    <!--  This button simulates swipe left (Delete)  -->
                    <ImageButton
                        Grid.RowSpan="2"
                        Grid.Column="3"
                        BackgroundColor="{StaticResource TransparentRed}"
                        Command="{Binding DeleteMealCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                        CommandParameter="{Binding}"
                        IsVisible="{OnPlatform Default=false,
                                               WinUI=true}" />
                    <!--  This button triggers a download  -->
                    <ImageButton
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="4"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding DownloadCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}"
                        CommandParameter="{Binding}"
                        HorizontalOptions="End"
                        IsVisible="{Binding IsCloudAllowed, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType=vm:MealListViewModel}" />
                    <!--#endregion-->
                    <!--#region Ruled Line-->
                    <BoxView
                        Grid.RowSpan="2"
                        Grid.ColumnSpan="6"
                        HeightRequest="1"
                        VerticalOptions="End"
                        Color="{AppThemeBinding Light={StaticResource Gray900},
                                                Dark={StaticResource White}}" />
                    <!--#endregion-->
                </Grid>
                <!--#endregion-->
            <!--#region SwipeView End -->
            </SwipeView>
            <!--#endregion-->
            <!--#endregion-->
        </DataTemplate>
        <toolkit:BoolToObjectConverter
            x:Key="IsGroupedConverter"
            FalseObject=" bills"
            TrueObject=" bills in groups" />
        <toolkit:BoolToObjectConverter
            x:Key="ShowBillsText"
            FalseObject="Show Venues"
            TrueObject="Show Bills" />
        <toolkit:BoolToObjectConverter
            x:Key="ShowLocalText"
            FalseObject="Show Local"
            TrueObject="Hide Local" />
        <toolkit:BoolToObjectConverter
            x:Key="ShowRemoteText"
            FalseObject="Show Remote"
            TrueObject="Hide Remote" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding ChangeListCommand}" IconImageSource="{StaticResource GlyphList}" />
        <ToolbarItem Command="{Binding DeleteMealCommand}" IconImageSource="{StaticResource GlyphDel}" />
        <ToolbarItem
            Command="{Binding InvokeUseMealCommand}"
            Order="Secondary"
            Text="Use" />
        <ToolbarItem
            Command="{Binding InvokeShowDetailsCommand}"
            Order="Secondary"
            Text="Show Details" />
        <ToolbarItem
            Command="{Binding DownloadCommand}"
            Order="Secondary"
            Text="Download" />
        <ToolbarItem
            Command="{Binding DeleteLocalMealsCommand}"
            Order="Secondary"
            Text="Delete Local" />
        <ToolbarItem
            Command="{Binding DeleteRemoteMealsCommand}"
            Order="Secondary"
            Text="Delete Remote" />
        <ToolbarItem
            Command="{Binding SelectNoneCommand}"
            Order="Secondary"
            Text="Select None" />
        <ToolbarItem
            Command="{Binding SelectAllCommand}"
            Order="Secondary"
            Text="Select All" />
        <ToolbarItem
            Command="{Binding InvertSelectionCommand}"
            Order="Secondary"
            Text="Invert Selection" />
        <ToolbarItem
            Command="{Binding ChangeFilterCommand}"
            Order="Secondary"
            Text="{Binding IsGrouped, Converter={StaticResource ShowBillsText}}" />
        <ToolbarItem
            Command="{Binding ChangeShowLocalMealsCommand}"
            Order="Secondary"
            Text="{Binding ShowLocalMeals, Converter={StaticResource ShowLocalText}}" />
        <ToolbarItem
            Command="{Binding ChangeShowRemoteMealsCommand}"
            Order="Secondary"
            Text="{Binding ShowRemoteMeals, Converter={StaticResource ShowRemoteText}}" />
    </ContentPage.ToolbarItems>
    <services:ColumnLayout Margin="0,0,0,10">
        <!--#region Page Heading -->
        <Label FontSize="Medium" HorizontalOptions="Center" Text="{Binding FilteredVenueName,StringFormat='For {0}'}"
               IsVisible="{Binding FilteredVenueName, Converter={StaticResource IsStringNotNullOrWhiteSpace}}"/>
        <Label FontSize="Medium" HorizontalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="{Binding SelectedMealSummariesCountText, StringFormat='{0} of', TargetNullValue=''}" />
                    <Span Text="{Binding MealList.Count, StringFormat=' {0}'}" />
                    <Span Text="{Binding WhereText, StringFormat=' {0}', TargetNullValue=''}" />
                    <Span Text="{Binding IsGrouped, Converter={StaticResource IsGroupedConverter}}" />
                    <Span Text="{Binding SortOrderName, StringFormat=' sorted by {0}'}" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <!--#endregion-->
        <!--#region Ruled Line-->
        <BoxView
            Margin="0,10,0,0"
            HeightRequest="1"
            VerticalOptions="End"
            Color="{AppThemeBinding Light={StaticResource Gray900},
                                    Dark={StaticResource White}}" />
        <!--#endregion-->
        <!--#region Busy Indicator when Meals are Loading-->
        <VerticalStackLayout IsVisible="{Binding IsMealListLoading}">
            <Label
                FontSize="Title"
                HorizontalOptions="Center"
                Text="Loading List..." />
            <ActivityIndicator
                HeightRequest="100"
                IsRunning="True"
                Color="{AppThemeBinding Light={StaticResource Gray900},
                                        Dark={StaticResource White}}" />
        </VerticalStackLayout>
        <!--#endregion-->
        <!--#region Progress Reporting and Cancel-->
        <Border
            HorizontalOptions="Center"
            IsVisible="{Binding IsBusy}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="2">
            <VerticalStackLayout>
                <HorizontalStackLayout
                    Margin="0,10,0,0"
                    HorizontalOptions="Center"
                    IsEnabled="True"
                    Spacing="10">
                    <Label Text="0" />
                    <ProgressBar
                        HeightRequest="50"
                        Progress="{Binding Progress}"
                        WidthRequest="250" />
                    <Label Text="{Binding ProgressLimit}" />
                </HorizontalStackLayout>
                <Button Command="{Binding CancelCommand}" Text="Cancel" />
            </VerticalStackLayout>
        </Border>
        <!--#endregion-->
        <!--#region Simple List of Meals-->
        <CollectionView
            x:Name="CurrentCollectionView"
            services:ColumnLayout.Fill="True"
            EmptyView="No bills found"
            ItemSizingStrategy="MeasureAllItems"
            ItemTemplate="{StaticResource WithSwipe}"
            ItemsSource="{Binding MealList}"
            Scrolled="OnCollectionViewScrolled"
            SelectedItem="{Binding SelectedMealSummary}"
            SelectionMode="{Binding MealCollectionMode}">
            <CollectionView.IsVisible>
                <MultiBinding Converter="{StaticResource All}">
                    <Binding Path="IsGrouped" Converter="{StaticResource Not}" />
                    <Binding Path="IsMealListLoading" Converter="{StaticResource Not}"/>
                </MultiBinding>
            </CollectionView.IsVisible>
        </CollectionView>
        <!--#endregion-->
        <!--#region List of Meals Grouped by Venue-->
        <CollectionView
            x:Name="CurrentGroupView"
            services:ColumnLayout.SameRow="True"
            services:ColumnLayout.Fill="True"
            EmptyView="No bill groups found"
            ItemSizingStrategy="MeasureAllItems"
            ItemsSource="{Binding MealSummaryGroups}"
            Scrolled="OnCollectionViewScrolled"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedGroup}">
            <CollectionView.IsVisible>
                <MultiBinding Converter="{StaticResource All}">
                    <Binding Path="IsGrouped"/>
                    <Binding Path="IsMealListLoading" Converter="{StaticResource Not}"/>
                </MultiBinding>
            </CollectionView.IsVisible>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MealSummaryGroup">
                    <toolkit:Expander
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                        CommandParameter ="{Binding}"
                        Command ="{Binding ShowGroupCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType = vm:MealListViewModel}">
                        <toolkit:Expander.Header>
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*, auto">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding VenueName}" FontSize="Large" />
                                        <Label Text="{Binding CountText, StringFormat='({0})'}" FontSize="Large" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*, auto"
                                        IsVisible="{Binding IsExpanded, Converter={StaticResource Not}, x:DataType = toolkit:Expander, Source={RelativeSource AncestorType={x:Type toolkit:Expander}}}">
                                    <Label FontSize="Small" Text="{Binding CreationTime, Converter={StaticResource ApproximateDateTime}}"/>
                                    <Label
                                        Grid.Column="1"
                                        Margin="0,0,34,0"
                                        FontSize="Small"
                                        HorizontalOptions="End"
                                        Text="{Binding Path=Distance, Converter={StaticResource Distance}}">
                                    </Label>
                                </Grid>
                                <BoxView VerticalOptions="End" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            </VerticalStackLayout>
                        </toolkit:Expander.Header>
                        <toolkit:Expander.Content>
                            <VerticalStackLayout>
                                <CollectionView 
                                    ItemsSource="{Binding FirstMealSummaries}"
                                    ItemTemplate="{StaticResource WithSwipe}"/>
                                <Button
                                    Text="Show All Bills for This Venue"
                                    Command="{Binding ShowMealsForVenueCommand, Source={RelativeSource AncestorType={x:Type vm:MealListViewModel}}, x:DataType = vm:MealListViewModel}"
                                    CommandParameter="{Binding VenueName}"
                                    IsVisible="{Binding CountLarge}"
                                    HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--#endregion-->
        <!--#region Scroll Up/Down "Buttons"-->
        <Border
            services:ColumnLayout.SameRow="True"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            StrokeShape="Ellipse"
            StrokeThickness="0"
            Padding="20">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"  Offset="0.4" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource TransparentWhite}, Dark=Transparent}" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
            <Label Text="{StaticResource TextArrowUp}"
               FontFamily="mdicons"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontSize="70"
               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <Border.IsVisible>
                <MultiBinding Converter="{StaticResource All}">
                    <Binding Path="IsSwipeDownAllowed"/>
                    <Binding Path="IsMealListScrolling" Converter="{StaticResource Not}"/>
                    <Binding Path="IsMealListLoading" Converter="{StaticResource Not}"/>
                </MultiBinding>
            </Border.IsVisible>
            <Border.Behaviors>
                <toolkit:TouchBehavior
                    BindingContext="{Binding Source={x:Reference BrowseItemsPage}, Path=BindingContext, x:DataType=ContentPage}"
                    Command="{Binding ScrollItemsCommand}" CommandParameter = "Down"
                    LongPressCommand="{Binding ScrollItemsCommand}" LongPressCommandParameter="Start"/>
            </Border.Behaviors>
        </Border>
        <Border
            services:ColumnLayout.SameRow="True"
            HorizontalOptions="Center"
            VerticalOptions="End"
            StrokeShape="Ellipse"
            StrokeThickness="0"
            Padding="20">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"  Offset="0.4" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource TransparentWhite}, Dark=Transparent}" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
            <Label Text="{StaticResource TextArrowDown}"
               FontFamily="mdicons"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontSize="70"
               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
            <Border.IsVisible>
                <MultiBinding Converter="{StaticResource All}">
                    <Binding Path="IsSwipeUpAllowed"/>
                    <Binding Path="IsMealListScrolling" Converter="{StaticResource Not}"/>
                    <Binding Path="IsMealListLoading" Converter="{StaticResource Not}"/>
                </MultiBinding>
            </Border.IsVisible>
            <Border.Behaviors>
                <toolkit:TouchBehavior
                    BindingContext="{Binding Source={x:Reference BrowseItemsPage}, Path=BindingContext, x:DataType=ContentPage}"
                    Command="{Binding ScrollItemsCommand}" CommandParameter = "Up"
                    LongPressCommand="{Binding ScrollItemsCommand}" LongPressCommandParameter="End"/>
            </Border.Behaviors>
        </Border>
        <!--#endregion-->
        <!--#region Undelete-->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Button
                Command="{Binding UndeleteCommand}"
                IsVisible="{Binding AnyDeleted}"
                Text="Undo Deletion" />
            <Button
                Command="{Binding UndeleteAllCommand}"
                IsVisible="{Binding ManyDeleted}"
                Text="Undo All Deletions" />
        </HorizontalStackLayout>
        <!--#endregion-->
    </services:ColumnLayout>
</ContentPage>