<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:sensors="clr-namespace:Microsoft.Maui.Devices.Sensors;assembly=Microsoft.Maui.Essentials"
             Shell.FlyoutBehavior="Disabled"
             x:DataType="MapViewModel"
             x:Class="DivisiBill.Views.MapPage"
             Title="MapPage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding ChangeMapTypeCommand}" IconImageSource="{StaticResource GlyphMap}"/>
        <ToolbarItem Command="{Binding RestoreCommand}" IconImageSource="{StaticResource GlyphRestore}"/>
        <ToolbarItem Command="{Binding ClearLocationCommand}" IconImageSource="{StaticResource GlyphMapMarkerRemove}"/>
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <maps:Circle x:Name="nativeAccuracyCircle" x:Key="nativeAccuracyCircle" FillColor="{StaticResource TransparentRed}" StrokeWidth="0"/>
    </ContentPage.Resources>
    <controls:ColumnLayout x:Name="rootLayout">
        <Label
            Text="{Binding VenueName, Mode=OneWay}"
            VerticalOptions="Center"
            HorizontalOptions="Center" FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"/>
        <Label VerticalOptions="Center" HorizontalOptions="Center">
            <Label.FormattedText>
                <FormattedString>
                    <FormattedString.Spans>
                        <Span Text="{Binding VenueLocation, StringFormat='Location={0}',Converter={StaticResource LocationToText}, TargetNullValue='Location Unknown'}"/>
                        <Span Text="{Binding VenueDistance, StringFormat=' ({0})',Converter={StaticResource Distance}, TargetNullValue=''}"/>
                    </FormattedString.Spans>
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <WebView x:Name="googleMapsWebView" controls:ColumnLayout.Fill="True"
                 Source="{Binding GoogleMapSource}"
                 IsEnabled="{OnPlatform false, WinUI=true}"
                 IsVisible="{OnPlatform false, WinUI=true}"/>

        <maps:Map x:Name="nativeMap" controls:ColumnLayout.Fill="True" controls:ColumnLayout.SameRow="True"
                  IsEnabled="{OnPlatform true, WinUI=false}"
                  IsVisible="{OnPlatform true, WinUI=false}"
                  MapClicked="OnNativeMapClicked"
                  IsShowingUser="{Binding MapIsShowingUser}"
                  MapType="{Binding CurrentMapType}"/>
    </controls:ColumnLayout>
</ContentPage>