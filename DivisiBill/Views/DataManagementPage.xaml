<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DivisiBill.Views.DataManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DivisiBill"
    xmlns:services="clr-namespace:DivisiBill.Services"
    xmlns:views="clr-namespace:DivisiBill.Views"
    xmlns:vm="clr-namespace:DivisiBill.ViewModels"
    Title="Manage Data"
    x:DataType="vm:DataManagementViewModel"
    BindingContext="{vm:DataManagementViewModel}"
    Shell.FlyoutBehavior="Flyout">
    <VerticalStackLayout Spacing="10">
        <!--#region Archive / Restore-->
        <Border Margin="30,10">
            <VerticalStackLayout>
                <Label
                    FontSize="Medium"
                    HorizontalOptions="Center"
                    Text="Archive and Restore" />
                <Grid
                    Margin="10"
                    ColumnDefinitions="auto, auto"
                    ColumnSpacing="10"
                    HorizontalOptions="Start"
                    RowDefinitions="auto, auto, auto, auto">
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Margin="5"
                        Command="{Binding ArchiveCommand}"
                        Text="Archive" />
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1">
                        <RadioButton
                            Content="To Share"
                            GroupName="ArchiveGroup"
                            IsChecked="{Binding ArchiveShare}" />
                        <RadioButton
                            Content="To Disk"
                            GroupName="ArchiveGroup"
                            IsChecked="{Binding ArchiveToDisk}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1">
                        <CheckBox IsChecked="{Binding OnlySelectedMeals}" />
                        <Label Text="Only Selected Bills" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
                <Grid
                    Margin="10"
                    ColumnDefinitions="auto, auto"
                    ColumnSpacing="10"
                    HorizontalOptions="Start"
                    RowDefinitions="auto, auto, auto, auto">
                    <Button
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Margin="5"
                        Command="{Binding RestoreArchiveCommand}"
                        Text="Restore" />
                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1">
                        <CheckBox IsChecked="{Binding DeleteBeforeRestore}" />
                        <Label Text="Delete Everything First" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout
                        Grid.Row="3"
                        Grid.Column="1"
                        IsEnabled="{Binding DeleteBeforeRestore, Converter={StaticResource Not}}">
                        <CheckBox IsChecked="{Binding OverwriteDuplicates}" />
                        <Label Text="Overwrite Duplicate Items" VerticalOptions="Center" LineBreakMode="WordWrap" WidthRequest="150" />
                    </HorizontalStackLayout>
                </Grid>
                <Label Text="Use Bills Between" FontAttributes="Bold" HorizontalOptions="Center"/>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,-10,0,0">
                    <DatePicker
                        Date="{Binding StartDate}"
                        MaximumDate="{Binding FinishDate}"
                        MinimumDate="{Static services:Archive.EarliestDateAllowed}" />
                    <Label Text="and" VerticalOptions="Center" />
                    <DatePicker
                        Date="{Binding FinishDate}"
                        MaximumDate="1/1/2100"
                        MinimumDate="{Binding StartDate}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center">
                    <CheckBox IsChecked="{Binding OnlyRelated}" />
                    <Label Text="Only Related People and Venues" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
        <!--#endregion-->
        <!--#region Bill Management-->
        <Border Margin="30,0">
            <VerticalStackLayout Spacing="10">
                <Label
                    FontSize="Medium"
                    HorizontalOptions="Center"
                    Text="Bill Management" />
                <Button
                    Command="{Binding SelectDownloadableCommand}"
                    HorizontalOptions="Center"
                    Text="Select Downloadable Bills" />
                <Button
                    Margin="10"
                    Command="{Binding SelectOlderCommand}"
                    HorizontalOptions="Center"
                    Text="Select All But Latest Bill Per Venue" />
            </VerticalStackLayout>
        </Border>
        <!--#endregion-->
        <!--#region Progress Reporting-->
        <ActivityIndicator
            HeightRequest="50"
            HorizontalOptions="Center"
            IsRunning="True"
            IsVisible="{Binding IsBusy}" />
        <!--#endregion-->
    </VerticalStackLayout>
</ContentPage>