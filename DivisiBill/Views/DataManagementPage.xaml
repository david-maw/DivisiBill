<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DivisiBill.Views.DataManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DivisiBill"
    xmlns:services="clr-namespace:DivisiBill.Services"
    xmlns:views="clr-namespace:DivisiBill.Views"
    xmlns:vm="clr-namespace:DivisiBill.ViewModels"
    Title="Manage Data"
    x:DataType="vm:DataManagementViewModel"
    BindingContext="{vm:DataManagementViewModel}"
    Shell.FlyoutBehavior="Flyout">
    <Grid>
        <!--#region Page Actions and Information-->
        <ScrollView>
            <VerticalStackLayout Spacing="5" Margin="5">
                <!--#region Archive / Restore-->
                <Border>
                    <VerticalStackLayout Spacing="10" Padding="10,0,10,10">
                        <Label
                            Margin="0,0,0,-10"
                            FontSize="{StaticResource FontSizeMedium}"
                            HorizontalOptions="Center"
                            Text="Data Archive and Restore" />
                        <!--#region Archive -->
                        <Grid
                            ColumnDefinitions="auto, auto"
                            ColumnSpacing="10"
                            HorizontalOptions="Start"
                            RowDefinitions="auto, auto, auto, auto">
                            <Button
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Margin="5"
                                Command="{Binding ArchiveCommand}"
                                Text="Archive" />
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10">
                                <RadioButton
                                    Content="To Share"
                                    GroupName="ArchiveGroup"
                                    IsChecked="{Binding ArchiveShare}" />
                                <RadioButton
                                    Content="To Disk"
                                    GroupName="ArchiveGroup"
                                    IsChecked="{Binding ArchiveToDisk}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1">
                                <CheckBox IsChecked="{Binding OnlySelectedMeals}" />
                                <Label Text="Only Selected Bills" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1">
                                <CheckBox IsChecked="{Binding SaveImages}" />
                                <Label Text="Store Bill Images" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                        <!--#endregion-->
                        <!--#region Select and Restore -->
                        <Grid
                            ColumnDefinitions="auto, auto"
                            ColumnSpacing="10"
                            HorizontalOptions="Start"
                            RowDefinitions="auto, auto, auto, auto">
                            <Button
                                Grid.Row="2"
                                Margin="5"
                                Command="{Binding SelectArchiveCommand}"
                                Text="Select" />
                            <Button
                                Grid.Row="2"
                                Margin="5"
                                IsVisible="{Binding SelectedArchive, Converter={StaticResource IsNotNull}}"
                                Command="{Binding ClearSelectedArchiveCommand}"
                                Text="Clear" />
                            <Button
                                Grid.Row="3"
                                Margin="5"
                                Command="{Binding RestoreArchiveCommand}"
                                Text="Restore"/>

                            <VerticalStackLayout Grid.Row="2" Grid.RowSpan="2"  Grid.Column="1">
                                <HorizontalStackLayout>
                                    <CheckBox IsChecked="{Binding RestoreSettings}" />
                                    <Label Text="Restore Program Settings" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout>
                                    <CheckBox IsChecked="{Binding DeleteBeforeRestore}" />
                                    <Label Text="Delete Everything First" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout IsEnabled="{Binding DeleteBeforeRestore, Converter={StaticResource Not}}">
                                    <CheckBox IsChecked="{Binding OverwriteDuplicates}" />
                                    <Label Text="Overwrite Duplicate Items" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                        <!--#endregion-->
                        <!--#region Date Range -->
                        <!--One or other of the following labels shows-->
                        <Label Text="{Binding MealsText}" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,-20,0,0">
                            <DatePicker
                                Date="{Binding StartDate}"
                                MaximumDate="{Binding FinishDate}"
                                MinimumDate="{Binding EarliestStartDate}" />
                            <Label Text="and" VerticalOptions="Center" />
                            <DatePicker
                                Date="{Binding FinishDate}"
                                MaximumDate="{Binding LatestFinishDate}"
                                MinimumDate="{Binding StartDate}" />
                        </HorizontalStackLayout>
                        <!--#endregion-->
                        <!--#region 'Only Related' Option-->
                        <HorizontalStackLayout HorizontalOptions="Center" Margin="0,-20,0,0">
                            <CheckBox IsChecked="{Binding OnlyRelated}" Margin="0,0,0,-10" />
                            <Label Text="Only Related People and Venues" VerticalOptions="Center" LineBreakMode="WordWrap" Margin="0,0,0,-10"/>
                        </HorizontalStackLayout>
                        <!--#endregion-->
                    </VerticalStackLayout>
                </Border>
                <!--#endregion-->
                <!--#region Key Archiving-->
                <Border>
                    <VerticalStackLayout Padding="10,0,10,10">
                        <Label
                            FontSize="{StaticResource FontSizeMedium}"
                            HorizontalOptions="Center"
                            Text="Key Archive and Restore" />
                            <Entry Placeholder="Required Password" WidthRequest="200" Text="{Binding KeyArchivePassword}" IsPassword="True" HorizontalOptions="Center" Margin="{OnPlatform Default='0,0,0,5', WinUI='0,9,0,10'}"/>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing ="10">
                            <Button Text="Archive to Disk" Command="{Binding ArchiveKeysCommand}"/>
                            <Button Text="Share Archive" Command="{Binding ArchiveKeysCommand}" CommandParameter="share"/>
                            <Button Text="Restore" Command="{Binding RestoreKeysCommand}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!--#endregion-->
                <!--#region Select Bills-->
                <Border>
                    <VerticalStackLayout Spacing="10" Padding="10,0,10,10">
                        <Label
                            FontSize="{StaticResource FontSizeMedium}"
                            HorizontalOptions="Center"
                            Text="Select Bills" />
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button
                                Command="{Binding SelectDownloadableCommand}"
                                Text="Downloadable" />
                            <Button
                                Command="{Binding SelectOlderCommand}"
                                Text="All But Latest Per Venue" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!--#endregion-->
                <!--#region Danger Area-->
                <Border>
                    <VerticalStackLayout Spacing="10" Padding="10,0,10,10">
                        <Label
                            FontSize="{StaticResource FontSizeMedium}"
                            HorizontalOptions="Center"
                            Text="DANGER AREA" />
                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Label Text="I understand this cannot be undone" VerticalOptions="Center"/>
                            <CheckBox x:Name="understood"/>
                        </HorizontalStackLayout>
                        <Button
                            Command="{Binding ClearCloudCommand}"
                            IsEnabled="{Binding IsChecked, Source={x:Reference understood}, x:DataType=CheckBox}"
                            HorizontalOptions="Center"
                            Text="Permanently Remove All My Cloud Data" />
                    </VerticalStackLayout>
                </Border>
                <!--#endregion-->
            </VerticalStackLayout>
        </ScrollView>
        <!--#endregion-->
        <!--#region Progress Reporting-->
        <ActivityIndicator
            HeightRequest="150"
            WidthRequest="{Binding HeightRequest, Source={RelativeSource Self}, x:DataType = ActivityIndicator}"
            HorizontalOptions="Center"
            IsRunning="True"
            IsVisible="{Binding IsBusy}" />
        <!--#endregion-->
    </Grid>
</ContentPage>