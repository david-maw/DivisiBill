<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="DivisiBill.Views.CheckWebPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DivisiBill"
    xmlns:http="clr-namespace:System.Net.Http;assembly=netstandard"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:DivisiBill.ViewModels"
    x:TypeArguments="http:HttpResponseMessage"
    x:DataType="vm:CheckWebPageViewModel"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Margin="0,0,0,5"
    Padding="0"
    BackgroundColor="Transparent">
    <Border
        Padding="10"
        BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                          Dark={StaticResource Gray900}}"
        HorizontalOptions="Center"
        StrokeShape="RoundRectangle 10"
        StrokeThickness="2">
        <VerticalStackLayout Spacing="10"
                             VerticalOptions="Center">
            <Label
                FontSize="Large"
                HorizontalOptions="Center"
                Text="{Binding PopupTitle}"
                VerticalOptions="Center" />
            <Label
                HorizontalOptions="Center"
                Text="{Binding StatusMessage}"
                VerticalOptions="Center" />
            <Label
                HorizontalOptions="Center"
                Text="{Binding StatusMessageExtra}"
                VerticalOptions="Center" />
            <ProgressBar
                HorizontalOptions="Center"
                Progress="{Binding Progress}"
                ScaleY="2"
                WidthRequest="200" />
            <Button
                Command="{Binding ClosePopupWindowCommand}"
                HorizontalOptions="Center"
                Text="Give Up" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>