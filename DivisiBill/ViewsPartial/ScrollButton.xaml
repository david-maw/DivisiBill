<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DivisiBill.Models"
             xmlns:services="clr-namespace:DivisiBill.Services"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewsPartial="clr-namespace:DivisiBill.ViewsPartial"
             HorizontalOptions="Center"
             VerticalOptions="Start"
             x:Name="scrollButton"
             x:DataType="viewsPartial:ScrollButton"
             x:Class="DivisiBill.ViewsPartial.ScrollButton">
    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:BoolToObjectConverter
            x:Key="ScrollDownIconConverter"
            FalseObject="{StaticResource TextArrowUp}"
            TrueObject="{StaticResource TextArrowDown}" />
        </ResourceDictionary>
    </ContentView.Resources>
    <Border
            HorizontalOptions="Center"
            VerticalOptions="Start"
            StrokeShape="Ellipse"
            StrokeThickness="0"
            Padding="20">
        <Border.Background>
            <RadialGradientBrush>
                <GradientStop Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"  Offset="0.4" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource TransparentWhite}, Dark=Transparent}" Offset="1.0" />
            </RadialGradientBrush>
        </Border.Background>
        <Label Text="{Binding Down, Converter={StaticResource ScrollDownIconConverter}, Source={x:Reference scrollButton}}"
               FontFamily="mdicons"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontSize="70"
               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
    </Border>
</ContentView>
