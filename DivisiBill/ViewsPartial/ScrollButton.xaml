<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DivisiBill.Models"
             xmlns:services="clr-namespace:DivisiBill.Services"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewsPartial="clr-namespace:DivisiBill.ViewsPartial"
             HorizontalOptions="Center"
             VerticalOptions="Start"
             x:Name="scrollButton"
             x:DataType="viewsPartial:ScrollButton"
             x:Class="DivisiBill.ViewsPartial.ScrollButton">
    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:BoolToObjectConverter
            x:Key="ScrollDownIconConverter"
            FalseObject="{StaticResource TextArrowUp}"
            TrueObject="{StaticResource TextArrowDown}" />
            <toolkit:BoolToObjectConverter
            x:Key="UpDownTextConverter"
            FalseObject="Down"
            TrueObject="Up"/>
            <toolkit:BoolToObjectConverter
            x:Key="StartEndTextConverter"
            FalseObject="Start"
            TrueObject="End"/>
        </ResourceDictionary>
    </ContentView.Resources>
    <Border
            x:Name="border"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            StrokeShape="Ellipse"
            StrokeThickness="0"
            Padding="20">
        <Border.Background>
            <RadialGradientBrush>
                <GradientStop Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"  Offset="0.4" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource TransparentWhite}, Dark=Transparent}" Offset="1.0" />
            </RadialGradientBrush>
        </Border.Background>
        <Label x:Name="label"
               Text="{Binding Down, Converter={StaticResource ScrollDownIconConverter}, Source={x:Reference scrollButton}}"
               FontFamily="mdicons"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontSize="70"
               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
        <Border.Behaviors>
            <toolkit:TouchBehavior
                    Command="{Binding PressCommand, Source={x:Reference scrollButton}}"
                    CommandParameter="{Binding Down, Converter={StaticResource UpDownTextConverter}, Source={x:Reference scrollButton}}"
                    LongPressCommand="{Binding LongPressCommand, Source={x:Reference scrollButton}}"
                    LongPressCommandParameter="{Binding Down, Converter={StaticResource StartEndTextConverter}, Source={x:Reference scrollButton}}"/>
        </Border.Behaviors>
    </Border>
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroupList>
            <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal">
                    <VisualState.Setters>
                        <Setter TargetName="label" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"/>
                        <Setter TargetName="border" Property="Border.StrokeThickness" Value="0" />
                        <Setter TargetName="label" Property="Label.Scale" Value="1.0"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState Name="Focused"/>

                <VisualState Name="Disabled">
                    <VisualState.Setters>
                        <Setter TargetName="label" Property="Label.TextColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray500}}"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState Name="PointerOver"/>

                <VisualState Name="Pressed">
                    <VisualState.Setters>
                        <Setter TargetName="label" Property="Label.Scale" Value="0.8"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState Name="LongPressed">
                    <VisualState.Setters>
                        <Setter TargetName="label" Property="Label.Scale" Value="1.2"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>
</ContentView>
