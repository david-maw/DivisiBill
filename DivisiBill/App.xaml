<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="DivisiBill.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:local="clr-namespace:DivisiBill"
    xmlns:services="clr-namespace:DivisiBill.Services"
    xmlns:controls="clr-namespace:DivisiBill.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:DivisiBill.ViewModels"
    android:Application.WindowSoftInputModeAdjust="Resize">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <services:TrueToStringConverter x:Key="TrueToString" />
            <services:CurrencyConverter x:Key="Currency" />
            <services:PercentConverter x:Key="Percent" />
            <services:InvertBoolConverter x:Key="Not" />
            <services:DistanceConverter x:Key="Distance" />
            <services:ApproximateDateTimeConverter x:Key="ApproximateDateTime"/>
            <services:LocationConverter x:Key="LocationToText" />
            <services:IsNonZeroConverter x:Key="IsNonZero" />
            <services:IsZeroConverter x:Key="IsZero" />
            <services:IsNegativeConverter x:Key="IsNegative" />
            <services:IsPositiveConverter x:Key="IsPositive" />
            <services:LocationIsValidConverter x:Key="IsLocationValid" />
            <services:AbsoluteCurrencyConverter x:Key="AbsoluteCurrency" />
            <services:BoolToOpacityConverter x:Key="BoolToOpacityConverter" /> 

            <toolkit:VariableMultiValueConverter x:Key="All" ConditionType="All"/>
            <toolkit:VariableMultiValueConverter x:Key="Any" ConditionType="Any" />
            <toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="IsStringNotNullOrWhiteSpace" />
            <toolkit:IsStringNullOrWhiteSpaceConverter x:Key="IsStringNullOrWhiteSpace" />
            <toolkit:IsNullConverter x:Key="IsNull" />
            <toolkit:IsNotNullConverter x:Key="IsNotNull" />
            <toolkit:VariableMultiValueConverter x:Key="And" ConditionType="All"/>
            <toolkit:VariableMultiValueConverter x:Key="Or" ConditionType="Any"/>
            <!--<viewModels:MealViewModel x:Key="MealViewModel"/>  is defined in code  -->

            <Color x:Key="PrimaryColor">#512bdf</Color>
            <Color x:Key="SecondaryColor">White</Color>
            <Color x:Key="TitlebarColor">#2196f3</Color>
            <Color x:Key="DarkText">#141414</Color>
            <Color x:Key="TransparentGreen">#14008000</Color>
            <Color x:Key="TransparentRed">#14FF0000</Color>
            <Color x:Key="LightRed">#F9C</Color>
            <Color x:Key="DarkRed">#900</Color>
            <Color x:Key="FileGlyphLight">LightSkyBlue</Color>
            <Color x:Key="FileGlyphDark">Blue</Color>
            <Color x:Key="ImageGlyphLight">LightGreen</Color>
            <Color x:Key="ImageGlyphDark">Green</Color>
            <Color x:Key="NegativeNumber">Red</Color>
            <Color x:Key="SelectedBackGroundColor">#f17b01</Color> <!-- Same color that Android uses by default -->
            <Color x:Key="MediumSpringGreen">#FF00FA9A</Color> <!--Same as corresponding CSS color-->

            <!--Icon names from "mdicons" Material Design Icons (https://materialdesignicons.com/), the names of the icons are included in comments for reference.-->

            <x:String x:Key="TextArrowDown">&#xF0CDC;</x:String> <!--arrow-down-circle-outline-->
            <x:String x:Key="TextArrowUp">&#xF0CE2;</x:String> <!--arrow-up-circle-outline-->

            <FontImageSource x:Key="FileGlyphLocalOutline"       Color="{AppThemeBinding Light={StaticResource FileGlyphDark}, Dark={StaticResource FileGlyphLight}}"  Glyph="&#xF0256;" FontFamily="mdicons"/> <!--folder-home-outline-->
            <FontImageSource x:Key="FileGlyphRemoteOutline"      Color="{AppThemeBinding Light={StaticResource FileGlyphDark}, Dark={StaticResource FileGlyphLight}}"  Glyph="&#xF0163;" FontFamily="mdicons"/> <!--cloud-outline-->
            <FontImageSource x:Key="FileGlyphLocal"              Color="{AppThemeBinding Light={StaticResource FileGlyphDark}, Dark={StaticResource FileGlyphLight}}"  Glyph="&#xF024B;" FontFamily="mdicons"/> <!--folder-->
            <FontImageSource x:Key="FileGlyphRemote"             Color="{AppThemeBinding Light={StaticResource FileGlyphDark}, Dark={StaticResource FileGlyphLight}}"  Glyph="&#xF015F;" FontFamily="mdicons"/> <!--cloud-->
            <FontImageSource x:Key="FileGlyphImage"              Color="{AppThemeBinding Light={StaticResource ImageGlyphDark}, Dark={StaticResource ImageGlyphLight}}"  Glyph="&#xF0976;" FontFamily="mdicons"/> <!--image-outline-->

            <FontImageSource x:Key="ListGlyphUnselected"        Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"  Glyph="&#xF0130;" FontFamily="mdicons"/> <!--checkbox-blank-circle-outline-->
            <FontImageSource x:Key="ListGlyphSelected"          Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"  Glyph="&#xF0134;" FontFamily="mdicons"/> <!--checkbox-marked-circle-outline-->
            <FontImageSource x:Key="ListGlyphCurrentMeal"       Color="{AppThemeBinding Light={StaticResource ImageGlyphDark}, Dark={StaticResource ImageGlyphLight}}"  Glyph="&#xF1A7D;" FontFamily="mdicons"/> <!--text-box-edit-outline-->

            <!--The following icons are used in ToolbarItem objects in various pages, always against a background of TitleBarColor.-->
            <FontImageSource x:Key="GlyphAdd"                   Color="White" Glyph="&#xF0419;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--plus-circle-outline-->
            <FontImageSource x:Key="GlyphBack"                  Color="White" Glyph="&#xF004D;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--arrow-left-->
            <FontImageSource x:Key="GlyphCamera"                Color="White" Glyph="&#xF0D5D;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--camera-outline-->
            <FontImageSource x:Key="GlyphCancel"                Color="White" Glyph="&#xF073A;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--cancel-->
            <FontImageSource x:Key="GlyphCheck"                 Color="White" Glyph="&#xF012C;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--check-->
            <FontImageSource x:Key="GlyphClose"                 Color="White" Glyph="&#xF0156;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--close-->
            <FontImageSource x:Key="GlyphCloud"                 Color="White" Glyph="&#xF015F;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--cloud-->
            <FontImageSource x:Key="GlyphCloudDownload"         Color="White" Glyph="&#xF0162;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--cloud-download-->
            <FontImageSource x:Key="GlyphCloudDownloadOutline"  Color="White" Glyph="&#xF0B7D;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--cloud-download-outline-->
            <FontImageSource x:Key="GlyphCloudOffOutline"       Color="White" Glyph="&#xF0164;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--cloud-off-outline-->
            <FontImageSource x:Key="GlyphCloudOutline"          Color="White" Glyph="&#xF0163;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--cloud-outline-->
            <FontImageSource x:Key="GlyphCrop"                  Color="White" Glyph="&#xF019E;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--crop-->
            <FontImageSource x:Key="GlyphDecrement"             Color="White" Glyph="&#xF0377;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--minus-circle-outline-->
            <FontImageSource x:Key="GlyphDel"                   Color="White" Glyph="&#xF0A7A;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--trash-can-->
            <FontImageSource x:Key="GlyphEdit"                  Color="White" Glyph="&#xF1A7D;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--text-box-edit-outline-->
            <FontImageSource x:Key="GlyphExit"                  Color="White" Glyph="&#xF0206;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--exit-to-app-->
            <FontImageSource x:Key="GlyphFile"                  Color="White" Glyph="&#xF0224;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--file-outline-->
            <FontImageSource x:Key="GlyphFileEdit"              Color="White" Glyph="&#xF11E8;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--file-edit-outline-->
            <FontImageSource x:Key="GlyphFilterOff"             Color="White" Glyph="&#xF14F0;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--filter-off-outline-->
            <FontImageSource x:Key="GlyphFilterOn"              Color="White" Glyph="&#xF0233;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--filter-outline-->
            <FontImageSource x:Key="GlyphFlashOff"              Color="White" Glyph="&#xF0243;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--flash-off-->
            <FontImageSource x:Key="GlyphFlashOn"               Color="White" Glyph="&#xF0241;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--flash-->
            <FontImageSource x:Key="GlyphFlashlightOff"         Color="White" Glyph="&#xF0245;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--flashlight-off-->
            <FontImageSource x:Key="GlyphFlashlightOn"          Color="White" Glyph="&#xF0244;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--flashlight-->
            <FontImageSource x:Key="GlyphFolder"                Color="White" Glyph="&#xF0256;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--folder-outline-->
            <FontImageSource x:Key="GlyphFolderOff"             Color="White" Glyph="&#xF19F9;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--folder-off-outline-->
            <FontImageSource x:Key="GlyphImages"                Color="White" Glyph="&#xF0978;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--image-search-outline-->
            <FontImageSource x:Key="GlyphImport"                Color="White" Glyph="&#xF02FA;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--import-->
            <FontImageSource x:Key="GlyphIncrement"             Color="White" Glyph="&#xF0419;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--plus-circle-outline-->
            <FontImageSource x:Key="GlyphList"                  Color="White" Glyph="&#xF0279;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--format-list-bulleted-->
            <FontImageSource x:Key="GlyphLoad"                  Color="White" Glyph="&#xF02FA;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--import-->
            <FontImageSource x:Key="GlyphMail"                  Color="White" Glyph="&#xF01F0;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--email-outline-->
            <FontImageSource x:Key="GlyphMap"                   Color="White" Glyph="&#xF0982;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--map-outline-->
            <FontImageSource x:Key="GlyphNull"                  Color="White" Glyph="&#xF07E2;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--null-->
            <FontImageSource x:Key="GlyphOCR"                   Color="White" Glyph="&#xF113A;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--ocr-->
            <FontImageSource x:Key="GlyphPersonEdit"            Color="White" Glyph="&#xF0FFB;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--account-edit-outline-->
            <FontImageSource x:Key="GlyphReplace"               Color="White" Glyph="&#xF0B33;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--file-replace-outline-->
            <FontImageSource x:Key="GlyphRotate90"              Color="White" Glyph="&#xF1A3E;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--file-rotate-clockwise-->
            <FontImageSource x:Key="GlyphMapMarker"             Color="White" Glyph="&#xF07D9;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--map-marker-outline-->
            <FontImageSource x:Key="GlyphMapMarkerRemove"       Color="White" Glyph="&#xF12FA;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--map-marker-remove-outline-->
            <FontImageSource x:Key="GlyphRestore"               Color="White" Glyph="&#xF099B;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--restore-->
            <FontImageSource x:Key="GlyphSave"                  Color="White" Glyph="&#xF0818;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--content-save-outline-->
            <FontImageSource x:Key="GlyphShare"                 Color="White" Glyph="&#xF0041;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--arrow-all-->
            <FontImageSource x:Key="GlyphSort"                  Color="White" Glyph="&#xF04BA;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--sort-->
            <FontImageSource x:Key="GlyphToc"                   Color="White" Glyph="&#xF0836;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--table-of-contents-->
            <FontImageSource x:Key="GlyphUndo"                  Color="White" Glyph="&#xF054C;" FontFamily="mdicons" controls:IconState.AutoGrayOut="True"/> <!--undo-->

            <!-- Font sizes -->
            <x:Double x:Key="FontSizeMicro">   10</x:Double>
            <x:Double x:Key="FontSizeCaption"> 12</x:Double>
            <x:Double x:Key="FontSizeHeader">  14</x:Double>
            <x:Double x:Key="FontSizeSmall">   14</x:Double>
            <x:Double x:Key="FontSizeBody">    16</x:Double>
            <x:Double x:Key="FontSizeSubtitle">16</x:Double>
            <x:Double x:Key="FontSizeMedium">  18</x:Double>
            <x:Double x:Key="FontSizeLarge">   22</x:Double>
            <x:Double x:Key="FontSizeTitle">   24</x:Double>

            <Style x:Key="HintStyle" TargetType="Border">
                <Setter Property="Padding" Value="5" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Yellow300Accent}, Dark={StaticResource Blue100Accent}}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            </Style>

            <Style x:Key="RedLabelTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="Red" />
            </Style>

            <Style x:Key="UnequalEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Yellow300Accent}, Dark={StaticResource Yellow100Accent}}" />
            </Style>
            <Style x:Key="InvalidEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightRed}, Dark={StaticResource DarkRed}}" />
            </Style>
            <Style x:Key="ValidEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>