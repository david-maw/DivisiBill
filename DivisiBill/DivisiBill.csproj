<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>DivisiBill</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>disable</ImplicitUsings>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies> <!--Because serialization assemblies do not play well with MAUI-->
    <LangVersion>preview</LangVersion> <!--In order to use partial properties via Community Toolkit-->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseMaterial3>true</UseMaterial3>
    <Nullable>enable</Nullable>
    <!--Suppress NU1608 warnings for AndroidX package version mismatches - these are resolved correctly by NuGet-->
    <NoWarn>$(NoWarn);NU1608</NoWarn>

    <!--Set packable false to eliminate a NU1105 warning since we never need to put this in a nuget package-->
    <IsPackable>false</IsPackable>

    <!-- Display name -->
    <ApplicationTitle>DivisiBill</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.autoplus.divisibill</ApplicationId>
    <ApplicationIdGuid>852FA570-F1CD-41BE-A828-5C1DE6ED088F</ApplicationIdGuid>

    <!-- Convenience Variable to determine the platform class (android, windows, etc.) based on the target framework.
    This is used in various conditions throughout the project file because TargetPlatformIdentifier is unreliable. -->
    <TargetOsPlatform>$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))</TargetOsPlatform>

    <!-- Versions -->
    <ApplicationDisplayVersion>6.3.32</ApplicationDisplayVersion>
    <ApplicationVersion>300</ApplicationVersion>

    <ApplicationVersion Condition="'$(DIVISIBILL_VERSION_INCREMENT)' != ''">$([MSBuild]::Add($(ApplicationVersion), $(DIVISIBILL_VERSION_INCREMENT)))</ApplicationVersion>

    <AssemblyVersion>$(ApplicationDisplayVersion).$(ApplicationVersion)</AssemblyVersion>

    <SupportedOSPlatformVersion Condition="$(TargetOsPlatform) == android">34.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetOsPlatform) == windows">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetOsPlatform) == windows">10.0.19041.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-us</DefaultLanguage>
    <Configurations>Debug;Release;ReleaseTest;Alternate</Configurations>
  </PropertyGroup>

  <!--Key for SixLabors licensing, set via environment variable on the build machine since it is needed at compile time for source generators and should not be checked into source control-->
  <PropertyGroup>
    <SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <!--Set EmitCompilerGeneratedFiles to true and CompilerGeneratedFilesOutputPath to an existing path to enable source-generated files to be visible in the IDE-->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles Condition="$(Configuration) == Debug">true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GenDump</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- Handy Diagnostic Messages -->
  <Target Name="ShowMessages" BeforeTargets="BeforeBuild;CoreCompile">
    <Message Text="TargetOsPlatform = $(TargetOsPlatform) and GetTargetPlatformIdentifier = $([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))" Importance="low" />
  </Target>

  <!-- Display the web service to be used by the build -->
  <Target Name="DisplayWebUri" BeforeTargets="CopyFilesToOutputDirectory" Condition="$(Configuration) == Debug">
    <Message Text="$(MSBuildProjectName) $(Configuration) build for $(TargetFramework), Web Service URI = $(DivisiBillWsUri)" Importance="high" />
  </Target>

  <PropertyGroup>
    <!--Enables 'dotnet run' (along with "commandName": "Project" in launchsettings.json)-->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!--Turn on Android AOT compilation to Speed Up initialization-->
  <PropertyGroup Condition="'$(Configuration)|$(TargetOsPlatform)|$(Platform)'=='Release|android|AnyCPU'">
    <RunAOTCompilation>True</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon, see https://learn.microsoft.com/en-us/dotnet/core/tools/sdk-errors/netsdk1005 -->
    <MauiIcon Condition="$(TargetOsPlatform) != android" Update="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="Red" />
    <MauiIcon Condition="$(TargetOsPlatform) == android" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="Red" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\appiconfg.svg" Color="Red" />
    <None Remove="Resources\Splash\appiconfg.svg" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet.svg" BaseSize="200,200" />
    <None Remove="Resources\Images\dotnet.svg" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- No need to store the explanatory text file in the app package since it is only used for development purposes, so remove it from the MauiAssets and it won't be included in the app bundle -->
    <MauiAsset Remove="Resources\Raw\AboutAssets.txt" />
    <!-- Raw Web site Assets for DivisiBill with a "help" prefix to prevent name collisions with any other raw resources -->
    <MauiAsset Include="..\web\divisibill\**" LogicalName="help\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Don't need the MD source files -->
    <MauiAsset Remove="..\web\divisibill\**\*.md" />
  </ItemGroup>

  <!--Release Notes-->
  <ItemGroup>
    <!--The release notes are in a different folder but go along with the other help files at run time-->
    <MauiAsset Include="Release Notes.html" LogicalName="help\releasenotes.html" />
    <MauiAsset Update="Release Notes.html">
      <DependentUpon>Release Notes.md</DependentUpon>
    </MauiAsset>
  </ItemGroup>

  <!--Nuget Packages-->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Maui.Camera" Version="6.1.0" />
    <PackageReference Include="CommunityToolkit.Maui.Maps" Version="4.0.0" />
    <PackageReference Include="epj.RouteGenerator" Version="1.0.5" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.90" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
    <PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.90" />
    <PackageReference Include="Sentry.Maui" Version="6.8.0" />
    <!--Sentry.Profiling 4.10.0 is not supported on Android-->
    <PackageReference Condition="'$(TargetOsPlatform)' != 'android'" Include="Sentry.Profiling" Version="6.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
  </ItemGroup>

  <!--Add In-App Billing package, but only for Android-->
  <ItemGroup Condition="'$(TargetOsPlatform)' == 'android'">
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="9.1.0.1" />
  </ItemGroup>

  <!-- Sentry setup for PDB Upload -->
  <PropertyGroup Condition="'$(Configuration)|$(TargetOsPlatform)|$(SENTRY_UPLOAD)' == 'Release|android|true' and '$(DIVISIBILL_SENTRY_DSN)' != ''">

    <!-- Configure Sentry org and project -->
    <SentryOrg>autoplus</SentryOrg>
    <SentryProject>divisibill</SentryProject>

    <!-- Sends symbols to Sentry, enabling symbolic stack traces. -->
    <SentryUploadSymbols>true</SentryUploadSymbols>

  </PropertyGroup>

  <!--Make Sure DEBUG is set on Alternate builds-->
  <PropertyGroup Condition="$(Configuration) == alternate">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <!--Generate the file holding the build secrets on every build-->
  <!--First get the secrets from environment variables-->
  <!--Set DivisiBillWsUri based on the build configuration-->

  <!--If it is a release build it's easy, just use the release environment variables-->
  <PropertyGroup Condition="$(Configuration) == release">
    <DivisiBillWsUri>$(DIVISIBILL_WS_URI_RELEASE)</DivisiBillWsUri>
    <DivisiBillWsKey>$(DIVISIBILL_WS_KEY_RELEASE)</DivisiBillWsKey>
  </PropertyGroup>

  <!--If it is an alternate build we use the alternate environment variables-->
  <PropertyGroup Condition="$(Configuration) == alternate">
    <DivisiBillWsUri Condition="'$(DivisiBillWsUri)' == ''">$(DIVISIBILL_ALTERNATE_WS_URI)</DivisiBillWsUri>
    <DivisiBillWsKey Condition="'$(DivisiBillWsKey)' == ''">$(DIVISIBILL_ALTERNATE_WS_KEY)</DivisiBillWsKey>
  </PropertyGroup>

  <!--If it is a debug build we need to check the target platform since the debug web service URI and key are allowed-->
  <!--to differ for Android and Windows-->
  <PropertyGroup Condition="'$(Configuration)|$(TargetOsPlatform)' == 'debug|android'">
    <DivisiBillWsUri Condition="'$(DivisiBillWsUri)' == ''">$(DIVISIBILL_WS_URI_DEBUGA)</DivisiBillWsUri>
    <DivisiBillWsKey Condition="'$(DivisiBillWsKey)' == ''">$(DIVISIBILL_WS_KEY_DEBUGA)</DivisiBillWsKey>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetOsPlatform)' == 'debug|windows'">
    <DivisiBillWsUri Condition="'$(DivisiBillWsUri)' == ''">$(DIVISIBILL_WS_URI_DEBUGW)</DivisiBillWsUri>
    <DivisiBillWsKey Condition="'$(DivisiBillWsKey)' == ''">$(DIVISIBILL_WS_KEY_DEBUGW)</DivisiBillWsKey>
  </PropertyGroup>

  <PropertyGroup>
    <!--If nothing has been recognized so far just use the released configuration-->
    <DivisiBillWsUri Condition="'$(DivisiBillWsUri)' == ''">$(DIVISIBILL_WS_URI)</DivisiBillWsUri>
    <DivisiBillWsKey Condition="'$(DivisiBillWsKey)' == ''">$(DIVISIBILL_WS_KEY)</DivisiBillWsKey>
    <BuildInfoText>
      <![CDATA[
// <auto-generated/>
// THIS FILE IS GENERATED BY EACH BUILD - DO NOT EDIT IT
namespace DivisiBill.Generated
{
    internal class BuildInfo
    {
        internal const string DivisiBillWsUri = "$(DivisiBillWsUri)"%3b
        internal const string DivisiBillWsKey = "$(DivisiBillWsKey)"%3b
        internal const string DivisiBillMapsKey = "$(DIVISIBILL_MAPS_KEY)"%3b
        internal const string DivisiBillSentryDsn = "$(DIVISIBILL_SENTRY_DSN)"%3b
        internal const string DivisiBillTestProJsonB64 = "$(DIVISIBILL_TEST_PRO_JSON_B64)"%3b
        internal const string DivisiBillTestOcrJsonB64 = "$(DIVISIBILL_TEST_OCR_JSON_B64)"%3b
        internal const string DivisiBillTestProSignatureB64 = "$(DIVISIBILL_TEST_PRO_SIGNATURE_B64)"%3b
        internal const string DivisiBillTestOcrSignatureB64 = "$(DIVISIBILL_TEST_OCR_SIGNATURE_B64)"%3b
    }
}
]]>
    </BuildInfoText>
  </PropertyGroup>

  <Target Name="AddBuildInfo" Inputs="$(MSBuildAllProjects)" BeforeTargets="BeforeBuild;CoreCompile" Outputs="ForceBuildEveryTime">
    <Message Text="AddBuildInfo was invoked for file $(BuildInfoFilePath)" Importance="low" />
    <PropertyGroup>
      <BuildInfoFilePath>$(IntermediateOutputPath)BuildGenerated\BuildInfo.g.cs</BuildInfoFilePath>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(BuildInfoFilePath)" />
      <FileWrites Include="$(BuildInfoFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(BuildInfoText)" File="$(BuildInfoFilePath)" Overwrite="true" />
  </Target>
  <!--End file generation-->

  <!--Generate the file holding the build timestamp, this changes on every build-->
  <PropertyGroup>
    <Today>$([System.DateTime]::UtcNow.ToString("O"))</Today>
    <BuildEnvironmentText>
      <![CDATA[
// <auto-generated/>
// THIS FILE IS GENERATED BY EACH BUILD - DO NOT EDIT IT
namespace DivisiBill.Generated
{
    internal static class BuildEnvironment
    {
        internal const string BuildTimeString = "$(Today)"%3b
    }
}
]]>
    </BuildEnvironmentText>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'" />

  <Target Name="AddBuildEnvironment" BeforeTargets="BeforeBuild;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="ForceBuildEveryTime">
    <Message Text="AddBuildEnvironment was invoked for file $(BuildInfoFilePath)" Importance="low" />
    <PropertyGroup>
      <BuildEnvironmentFilePath>$(IntermediateOutputPath)BuildGenerated\BuildEnvironment.g.cs</BuildEnvironmentFilePath>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(BuildEnvironmentFilePath)" />
      <FileWrites Include="$(BuildEnvironmentFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(BuildEnvironmentText)" File="$(BuildEnvironmentFilePath)" Overwrite="true" />
  </Target>
  <!--End file generation-->
</Project>
